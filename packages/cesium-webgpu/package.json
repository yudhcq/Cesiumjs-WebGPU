{
  "name": "cesium-webgpu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebGPU renderer backend replacement for CesiumJS (controlled fork / module-level patch layer)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./escape-hatch": {
      "types": "./dist/escape-hatch.d.ts",
      "import": "./dist/escape-hatch.js"
    }
  },
  "files": [
    "dist",
    "backend-webgpu",
    "fixtures",
    "types"
  ],
  "scripts": {
    "build": "node ../../tools/scripts/run.mjs build",
    "typecheck": "node ../../tools/scripts/run.mjs typecheck"
  },
  "dependencies": {
    "@cesium/engine": "26.3.0"
  }
}
