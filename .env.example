# Local developer configuration template — copy to `.env` and adjust.
# `.env` is gitignored; this template is committed. Never put credentials here:
# the MVP uses public, login-free terrain sources only.

# --- npm registry access -----------------------------------------------------
# npm usually reaches the registry directly. Set these only when it does not.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# --- render path selection ---------------------------------------------------
# A configuration value for the package (see contracts/render-path-api.md §2).
# Exactly one backend runs per session; the value is never inspected by callers.
# RENDER_BACKEND=webgpu
# RENDER_BACKEND=webgl2

# Force the capability probe to report "unavailable" so the whole-backend fallback
# path can be exercised locally (quickstart §3.3).
# FORCE_NO_WEBGPU=1

# --- demo / static server ----------------------------------------------------
# DEMO_PORT=8080
# DEMO_HOST=127.0.0.1

# --- shader toolchain (one-shot conversion + CI validation only) -------------
# glslang 16.6.0 ships as an official prebuilt Linux archive; naga-cli 30.0.1 has no
# prebuilt binary and MUST be installed with an explicit version and --locked.
# GLSLANG_BIN=/path/to/glslang/bin
# NAGA_BIN=/path/to/naga
